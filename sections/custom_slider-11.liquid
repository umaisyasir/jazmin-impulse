<style>
  .slider-container {
    width: 100%;
    max-width: 1200px;
    position: relative;
    margin: 0 auto;
    overflow: hidden;
  }

  .slider {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    transition: transform 0.5s ease-in-out;
  }

  .slide {
    min-width: 300px;
    margin: 0 10px;
    transition: transform 0.5s ease, opacity 0.5s ease;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0.5;
    position: relative;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 15px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .slide.active {
    transform: scale(1.2);
    opacity: 1;
    z-index: 2;
  }

  .slide.left, .slide.right {
    transform: scale(0.8);
  }

  /* Navigation buttons */
  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    padding: 8px 15px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 10;
    font-size: 20px;
    transition: background 0.3s ease;
  }

  .prev-btn {
    left: 20px;
  }

  .next-btn {
    right: 20px;
  }

  .nav-btn:hover {
    background: #000;
  }

  @media (max-width: 768px) {
    .slide {
      min-width: 200px;
    }

    .slide.active {
      transform: scale(1.1);
    }

    .nav-btn {
      font-size: 18px;
    }
  }
</style>

<div class="slider-container">
  <div class="slider">
    {% for block in section.blocks %}
      <div class="slide">
        <a href="{{ block.settings.link }}"><img src="{{ block.settings.image | img_url: 'master' }}" alt="Slide {{ forloop.index }}"></a>
      </div>
    {% endfor %}
  </div>

  <!-- Navigation buttons -->
  <div class="nav-btn prev-btn">&#10094;</div>
  <div class="nav-btn next-btn">&#10095;</div>
</div>

<script>
  const slides = document.querySelectorAll('.slide');
  const prevBtn = document.querySelector('.prev-btn');
  const nextBtn = document.querySelector('.next-btn');
  let current = 0;

  function updateSlides() {
    slides.forEach((slide, index) => {
      slide.classList.remove('active', 'left', 'right');
      if (index === current) {
        slide.classList.add('active');
      } else if (index === (current + 1) % slides.length) {
        slide.classList.add('right');
      } else if (index === (current - 1 + slides.length) % slides.length) {
        slide.classList.add('left');
      }
    });
  }

  nextBtn.addEventListener('click', () => {
    current = (current + 1) % slides.length;
    updateSlides();
  });

  prevBtn.addEventListener('click', () => {
    current = (current - 1 + slides.length) % slides.length;
    updateSlides();
  });

  updateSlides();
</script>

{% schema %}
{
  "name": "VB - Custom Triple Slider",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "Slide",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Select URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VB - Custom Triple Slider",
      "category": "Sliders"
    }
  ]
}
{% endschema %}