{{ 'cstm-featured-collection.css' | asset_url | stylesheet_tag }}

{% comment %}
  Featured Collection Section with Swiper Slider
{% endcomment %}

<div class="container_featuredcollection">
  <div class="section-{{ section.id }} swiper-container featured-collection-slider">
    <!-- Heading from Schema Settings -->
    <h2 class="section-title">{{ section.settings.section_title }}</h2>
  
    <div class="swiper-wrapper">
        {% assign products = collections[section.settings.collection].products %}
        {% for product in products %}
          <div class="swiper-slide">
            {% render 'product-grid-item', product: product %}
          </div>
        {% endfor %}
    </div>
  
    <!-- Pagination controls for Swiper (hidden) -->
    <div class="swiper-pagination"></div>
    <div class="swiper-button-next"><i class="fas fa-chevron-right"></i></div>
    <div class="swiper-button-prev"><i class="fas fa-chevron-left"></i></div>
  </div>
</div>

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  var swiper = new Swiper('.section-{{ section.id }}.swiper-container', {
    slidesPerView: 1,
    spaceBetween: 20,
    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
    },
    loop: true,
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    breakpoints: {
      768: {
        slidesPerView: 4, // 4 products on desktop
      },
    },
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "collection",
      "label": "Select Collection",
      "id": "collection",
      "info": "Choose the collection to display"
    },
    {
      "type": "text",
      "label": "Section Title",
      "id": "section_title",
      "default": "Featured Collection",
      "info": "Set a title for this section"
    },
    {
      "type": "number",
      "label": "Number of Products",
      "id": "num_products",
      "default": 4,
      "info": "Set the number of products to display at once"
    },
    {
      "type": "checkbox",
      "label": "Enable Autoplay",
      "id": "autoplay",
      "default": true,
      "info": "Toggle autoplay functionality"
    },
    {
      "type": "number",
      "label": "Autoplay Delay (ms)",
      "id": "autoplay_delay",
      "default": 5000,
      "info": "Set the delay for autoplay in milliseconds"
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Collection"
    }
  ]
}
{% endschema %}