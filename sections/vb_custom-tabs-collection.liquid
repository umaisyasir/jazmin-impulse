<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

{{ 'vb_custom-tabs.css' | asset_url | stylesheet_tag }}

<div class="section-{{ section.id }} cstm-tabs-container">
  <!-- Tabs Navigation -->
  <div class="tabs-nav">
    {% for block in section.blocks %}
      <button class="tab-link{% if forloop.first %} active{% endif %}" data-tab="tab-{{ block.id }}">{{ block.settings.collection.title }}</button>
    {% endfor %}
  </div>

  <!-- Tabs Content -->
  <div class="tabs-content">
    {% for block in section.blocks %}
      <div id="tab-{{ block.id }}" class="tab-pane{% if forloop.first %} active{% endif %}">
        <!-- Swiper Slider for Products -->
        <div class="swiper-container section-{{ section.id }}-{{ block.id }}">
          <div class="section-{{ section.id }} swiper-wrapper">
            {% for product in block.settings.collection.products limit: block.settings.product_limit %}
              <div class="swiper-slide product-grid-item">
                {% render 'product-grid-item', product: product %}
              </div>
            {% endfor %}
          </div>
          <!-- Add Pagination, Next/Prev Buttons -->
          <div class="swiper-pagination"></div>
          <div class="swiper-button-next"></div>
          <div class="swiper-button-prev"></div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var tabLinks = document.querySelectorAll('.tab-link');
    var tabPanes = document.querySelectorAll('.tab-pane');

    // Handle Tab Click
    tabLinks.forEach(function (link) {
      link.addEventListener('click', function () {
        var tabId = link.getAttribute('data-tab');

        // Remove active class from all tabs and contents
        tabLinks.forEach(l => l.classList.remove('active'));
        tabPanes.forEach(p => p.classList.remove('active'));

        // Add active class to the clicked tab and the corresponding tab content
        link.classList.add('active');
        document.getElementById(tabId).classList.add('active');
      });
    });

    // Initialize Swiper sliders for each tab pane
    {% for block in section.blocks %}
    new Swiper('.section-{{ section.id }}-{{ block.id }} .swiper-container', {
      slidesPerView: 4,
      spaceBetween: 30,
      loop: true,
      pagination: {
        el: '.section-{{ section.id }}-{{ block.id }} .swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.section-{{ section.id }}-{{ block.id }} .swiper-button-next',
        prevEl: '.section-{{ section.id }}-{{ block.id }} .swiper-button-prev',
      },
      breakpoints: {
        768: {
          slidesPerView: 2,
        },
        1024: {
          slidesPerView: 3,
        },
        1280: {
          slidesPerView: 4,
        },
      },
    });
    {% endfor %}
  });
</script>

{% schema %}
{
  "name": "Custom Tabs Collections",
  "settings": [
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products per tab (Global)",
      "default": 4,
      "min": 1,
      "max": 10
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "range",
          "id": "product_limit",
          "label": "Number of products for this tab",
          "default": 4,
          "min": 1,
          "max": 10
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Tabs Collections",
      "category": "Collection"
    }
  ]
}
{% endschema %}