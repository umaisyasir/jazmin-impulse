<style>
@media screen and (min-width: 769px) {
  .slider_height {
    height: calc (100vh - 42px);
  }
}

@media screen and (max-width: 768px) {
  .slider_height {
    height: calc (100vh - 90px);
  }
}
</style>

<link rel="stylesheet" href="https://fashion-slider.uiinitiative.com/assets/index.fca86069.css"/>
<link rel="modulepreload" href="https://fashion-slider.uiinitiative.com/assets/vendor.688a9bfa.js"/>
<script type="module" crossorigin src="https://fashion-slider.uiinitiative.com/assets/index.ff8f4572.js"></script>

<div class="fashion-slider">
      <div class="swiper">
        <div class="swiper-wrapper slider_height">
          {% for block in section.blocks %}
          <div class="swiper-slide" data-slide-bg-color="#D1C4B4">
            <!-- slide title wrap -->
            <div class="fashion-slider-title" data-swiper-parallax="-130%">
              <!-- slide title text -->
              <div class="fashion-slider-title-text">{{ block.settings.image_content }}</div>
            </div>
            <!-- slide image wrap -->
            <div class="fashion-slider-scale">
              <!-- slide image -->
              <img
                src="{{ block.settings.image | img_url: 'master' }}" class="desktop_image"
                data-mobile-image="{{ block.settings.mobile_image | img_url: 'master' }}" />
            </div>
          </div>
          {% endfor %}
        </div>
        <div class="fashion-slider-button-prev fashion-slider-button">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 350 160 90">
            <g class="fashion-slider-svg-wrap">
              <g class="fashion-slider-svg-circle-wrap">
                <circle cx="42" cy="42" r="40"></circle>
              </g>
              <path
                class="fashion-slider-svg-arrow"
                d="M.983,6.929,4.447,3.464.983,0,0,.983,2.482,3.464,0,5.946Z"
              ></path>
              <path class="fashion-slider-svg-line" d="M80,0H0"></path>
            </g>
          </svg>
        </div>

        <div class="fashion-slider-button-next fashion-slider-button">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 350 160 90">
            <g class="fashion-slider-svg-wrap">
              <g class="fashion-slider-svg-circle-wrap">
                <circle cx="42" cy="42" r="40"></circle>
              </g>
              <path
                class="fashion-slider-svg-arrow"
                d="M.983,6.929,4.447,3.464.983,0,0,.983,2.482,3.464,0,5.946Z"
              ></path>
              <path class="fashion-slider-svg-line" d="M80,0H0"></path>
            </g>
          </svg>
        </div>
      </div>
    </div>

<script>
  window.addEventListener('resize', updateSliderImage);
  window.addEventListener('load', updateSliderImage);

  function updateSliderImage() {
    const isMobile = window.innerWidth <= 768; // Adjust this value based on your mobile breakpoint
    const slides = document.querySelectorAll('.swiper-slide');

    slides.forEach(slide => {
      const imageElement = slide.querySelector('img.desktop_image');
      if (imageElement) {
        const mobileImage = imageElement.getAttribute('data-mobile-image'); // Get mobile image URL from data attribute
        if (isMobile) {
          imageElement.setAttribute('src', mobileImage); // Set the mobile image
        } else {
          imageElement.setAttribute('src', imageElement.src.replace('mobile', 'master')); // Reset to desktop version for larger screens
        }
      }
    });
  }
</script>

{% schema %}
{
  "name": "Custom Slider",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "text",
          "id": "image_content",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Select Mobile Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Slider"
    }
  ]
}
{% endschema %}