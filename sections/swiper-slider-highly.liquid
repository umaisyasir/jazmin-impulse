<style>
  @media screen and (min-width: 769px) {
    .slider_height {
      height: calc(100vh - 42px) !important;
    }

    .mobile-image {
      display: none;
    }

    .desktop-image {
      display: block;
    }
  }

  @media screen and (max-width: 768px) {
    .slider_height {
      height: calc(100vh - 140px) !important;
    }

    .fashion-slider-title-text {
      font-size: xx-large;
    }

    .fashion-slider-scale img {
      transform: scale(1.0) translate(0%) !important;
    }

    .desktop-image {
      display: none;
    }

    .mobile-image {
      display: block;
    }
  }
</style>

<link rel="stylesheet" href="https://fashion-slider.uiinitiative.com/assets/index.fca86069.css"/>
<link rel="modulepreload" href="https://fashion-slider.uiinitiative.com/assets/vendor.688a9bfa.js"/>
<script type="module" crossorigin src="https://fashion-slider.uiinitiative.com/assets/index.ff8f4572.js"></script>

<div class="fashion-slider">
  <div class="swiper">
    <div class="swiper-wrapper slider_height">
      {% for block in section.blocks %}
      <div class="swiper-slide" data-slide-bg-color="#D1C4B4">
        <!-- slide title wrap -->
        <div class="fashion-slider-title" data-swiper-parallax="-130%">
          <!-- slide title text -->
          <div class="fashion-slider-title-text">{{ block.settings.image_content }}</div>
        </div>
        <!-- slide image wrap -->
        <div class="fashion-slider-scale">
          <!-- Desktop Image -->
          <img 
            src="{{ block.settings.image | img_url: 'master' }}" 
            class="desktop-image" 
            alt="Desktop Image"
          />
          <!-- Mobile Image -->
          <img 
            src="{{ block.settings.mobile_image | img_url: 'master' }}" 
            class="mobile-image" 
            alt="Mobile Image"
          />
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="fashion-slider-button-prev fashion-slider-button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 350 160 90">
        <g class="fashion-slider-svg-wrap">
          <g class="fashion-slider-svg-circle-wrap">
            <circle cx="42" cy="42" r="40"></circle>
          </g>
          <path class="fashion-slider-svg-arrow" d="M.983,6.929,4.447,3.464.983,0,0,.983,2.482,3.464,0,5.946Z"></path>
          <path class="fashion-slider-svg-line" d="M80,0H0"></path>
        </g>
      </svg>
    </div>

    <div class="fashion-slider-button-next fashion-slider-button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 350 160 90">
        <g class="fashion-slider-svg-wrap">
          <g class="fashion-slider-svg-circle-wrap">
            <circle cx="42" cy="42" r="40"></circle>
          </g>
          <path class="fashion-slider-svg-arrow" d="M.983,6.929,4.447,3.464.983,0,0,.983,2.482,3.464,0,5.946Z"></path>
          <path class="fashion-slider-svg-line" d="M80,0H0"></path>
        </g>
      </svg>
    </div>
  </div>
</div>

<script>
  let resizeTimeout;
  
  window.addEventListener('resize', () => {
    if (resizeTimeout) clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(updateSliderImage, 100); // Debounce resize event (adjust 100ms if needed)
  });

  window.addEventListener('load', () => {
    updateSliderImage();
    initializeSwiper(); // Initialize Swiper after images are set
  });

  function updateSliderImage() {
    const isMobile = window.innerWidth <= 768; // Adjust this value based on your mobile breakpoint
    const slides = document.querySelectorAll('.swiper-slide');

    slides.forEach(slide => {
      const desktopImage = slide.querySelector('img.desktop-image');
      const mobileImage = slide.querySelector('img.mobile-image');

      if (desktopImage && mobileImage) {
        if (isMobile) {
          desktopImage.style.display = 'none'; // Hide desktop image on mobile
          mobileImage.style.display = 'block'; // Show mobile image on mobile
        } else {
          desktopImage.style.display = 'block'; // Show desktop image on desktop
          mobileImage.style.display = 'none'; // Hide mobile image on desktop
        }
      }
    });
  }

  function initializeSwiper() {
    // Initialize Swiper after images are set to ensure the slider functions properly
    const swiper = new Swiper('.swiper', {
      loop: true,
      navigation: {
        nextEl: '.fashion-slider-button-next',
        prevEl: '.fashion-slider-button-prev',
      },
      autoplay: {
        delay: 5000, // Adjust autoplay speed (5 seconds)
      },
      effect: 'slide', // Adjust slider effect (you can use 'fade', 'slide', 'cube', etc.)
    });
  }
</script>

{% schema %}
{
  "name": "Custom Slider",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "text",
          "id": "image_content",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Select Mobile Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Slider"
    }
  ]
}
{% endschema %}