<style>
/* Hide desktop image on mobile devices and show mobile image */
@media screen and (max-width: 768px) {
  .desktop_image {
    display: none !important;
  }
  
  .mobile_image {
    display: block !important;
    width: 100%;
    height: auto;
  }

  .fashion-slider-scale img {
    transform: scale(1.2) translate(0%) !important;
  }
}

/* Hide mobile image on desktop devices and show desktop image */
@media screen and (min-width: 769px) {
  .desktop_image {
    display: block !important;
    width: 100%;
    height: auto;
  }
  
  .mobile_image {
    display: none !important;
  }
}

/* Styling for the Swiper buttons to ensure they work on all views */
.fashion-slider-button-prev,
.fashion-slider-button-next {
  position: absolute;
  top: 50%;
  z-index: 10;
  width: 50px;
  height: 50px;
  cursor: pointer;
  background: transparent;
  border: none;
  outline: none;
  transition: transform 0.3s ease;
}

.fashion-slider-button-prev {
  left: 10px;
}

.fashion-slider-button-next {
  right: 10px;
}

.fashion-slider-button-prev:hover,
.fashion-slider-button-next:hover {
  transform: scale(1.1);
}

/* For smaller screens, adjust the size and placement of the buttons */
@media screen and (max-width: 768px) {
  .fashion-slider-button-prev,
  .fashion-slider-button-next {
    width: 40px;
    height: 40px;
    top: 90%;
  }

  .fashion-slider-button-prev {
    left: 5px;
  }

  .fashion-slider-button-next {
    right: 5px;
  }
}
</style>

<link rel="stylesheet" href="https://fashion-slider.uiinitiative.com/assets/index.fca86069.css"/>
<link rel="modulepreload" href="https://fashion-slider.uiinitiative.com/assets/vendor.688a9bfa.js"/>
<script type="module" crossorigin src="https://fashion-slider.uiinitiative.com/assets/index.ff8f4572.js"></script>

<div class="fashion-slider">
  <div class="swiper">
    <div class="swiper-wrapper" style="height: calc(100vh - 42px);">
      {% for block in section.blocks %}
      <div class="swiper-slide" data-slide-bg-color="#D1C4B4">
        <!-- slide title wrap -->
        <div class="fashion-slider-title" data-swiper-parallax="-130%">
          <!-- slide title text -->
          <div class="fashion-slider-title-text">{{ block.settings.image_content }}</div>
        </div>
        <!-- slide image wrap with both desktop and mobile images -->
        <div class="fashion-slider-scale">
          <!-- Desktop image -->
          <img
            src="{{ block.settings.image | img_url: 'master' }}" class="desktop_image"
            alt="Desktop Image"
          />
          <!-- Mobile image -->
          <img
            src="{{ block.settings.mobile_image | img_url: 'master' }}" class="mobile_image"
            alt="Mobile Image"
          />
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="fashion-slider-button-prev fashion-slider-button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 350 160 90">
        <g class="fashion-slider-svg-wrap">
          <g class="fashion-slider-svg-circle-wrap">
            <circle cx="42" cy="42" r="40"></circle>
          </g>
          <path
            class="fashion-slider-svg-arrow"
            d="M.983,6.929,4.447,3.464.983,0,0,.983,2.482,3.464,0,5.946Z"
          ></path>
          <path class="fashion-slider-svg-line" d="M80,0H0"></path>
        </g>
      </svg>
    </div>

    <div class="fashion-slider-button-next fashion-slider-button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 350 160 90">
        <g class="fashion-slider-svg-wrap">
          <g class="fashion-slider-svg-circle-wrap">
            <circle cx="42" cy="42" r="40"></circle>
          </g>
          <path
            class="fashion-slider-svg-arrow"
            d="M.983,6.929,4.447,3.464.983,0,0,.983,2.482,3.464,0,5.946Z"
          ></path>
          <path class="fashion-slider-svg-line" d="M80,0H0"></path>
        </g>
      </svg>
    </div>
  </div>
</div>

<script>
  const swiper = new Swiper('.swiper', {
    loop: true,
    navigation: {
      nextEl: '.fashion-slider-button-next',
      prevEl: '.fashion-slider-button-prev',
    },
  });
</script>

{% schema %}
{
  "name": "Custom Slider",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "text",
          "id": "image_content",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Select Mobile Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Slider"
    }
  ]
}
{% endschema %}
