<style>
  @media screen and (min-width: 769px) {
    .slider_height {
      height: calc(100vh - 42px) !important;
    }

    .fashion-slider-title-text {
      font-size: 50px !important;
      letter-spacing: 2px !important;
      margin-bottom: 10px;
    }

    .fashion-slider .swiper-slide {
      align-items: flex-end !important;
    }

    .fashion-slider-title {
      margin-bottom: 20px !important;
    }
  }

  @media screen and (max-width: 768px) {
    .slider_height {
      height: calc(100vh - 140px) !important;
    }
  }
</style>

<link rel="stylesheet" href="https://fashion-slider.uiinitiative.com/assets/index.fca86069.css"/>
<link rel="modulepreload" href="https://fashion-slider.uiinitiative.com/assets/vendor.688a9bfa.js"/>
<script type="module" crossorigin src="https://fashion-slider.uiinitiative.com/assets/index.ff8f4572.js"></script>

<div class="fashion-slider">
  <div class="swiper">
    <div class="swiper-wrapper slider_height">
      {% for block in section.blocks %}
      <div class="swiper-slide" data-slide-bg-color="#D1C4B4">
        <!-- slide title wrap -->
        <div class="fashion-slider-title" data-swiper-parallax="-130%">
          <!-- slide title text -->
          <div class="fashion-slider-title-text">{{ block.settings.image_content }}</div>
          <a href="{{ block.settings.link }}" class="custom-button">Shop Now</a>
          <style>
            .custom-button {
              display: inline-block;
              padding: 10px 20px;
              background-color: black;
              color: white;
              font-size: 16px;
              font-weight: bold;
              text-transform: uppercase;
              letter-spacing: 1px;
              border: 2px solid transparent;
              border-radius: 50px;
              transition: all 0.4s ease;
              position: relative;
              overflow: hidden;
              z-index: 1;
            }
            
            .custom-button::before {
              content: '';
              position: absolute;
              top: 0;
              left: 0;
              width: 100%;
              height: 100%;
              background: white;
              z-index: -1;
              transition: all 0.4s ease;
              transform: scaleX(0);
              transform-origin: right;
            }
            
            .custom-button:hover::before {
              transform: scaleX(1);
              transform-origin: left;
            }
            
            .custom-button:hover {
              color: black;
              border-color: black;
            }
            
            /* Adding high-end animation */
            @keyframes bounceIn {
              0% {
                opacity: 0;
                transform: scale(0.5);
              }
              80% {
                transform: scale(1.05);
              }
              100% {
                opacity: 1;
                transform: scale(1);
              }
            }
            
            .custom-button {
              animation: bounceIn 0.8s ease-in-out;
            }
          </style>
        </div>
        <!-- slide image wrap -->
        <div class="fashion-slider-scale">
          <!-- slide image -->
          <a href="{{ block.settings.link }}">
          <img
            src="{{ block.settings.image | img_url: 'master' }}" 
            class="desktop_image"
            data-mobile-image="{{ block.settings.mobile_image | img_url: 'master' }}" 
            alt="Slider Image"
          />
          </a>
        </div>
        </div>
      {% endfor %}
    </div>

    <div class="fashion-slider-button-prev fashion-slider-button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 350 160 90">
        <g class="fashion-slider-svg-wrap">
          <g class="fashion-slider-svg-circle-wrap">
            <circle cx="42" cy="42" r="40"></circle>
          </g>
          <path class="fashion-slider-svg-arrow" d="M.983,6.929,4.447,3.464.983,0,0,.983,2.482,3.464,0,5.946Z"></path>
          <path class="fashion-slider-svg-line" d="M80,0H0"></path>
        </g>
      </svg>
    </div>

    <div class="fashion-slider-button-next fashion-slider-button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 350 160 90">
        <g class="fashion-slider-svg-wrap">
          <g class="fashion-slider-svg-circle-wrap">
            <circle cx="42" cy="42" r="40"></circle>
          </g>
          <path class="fashion-slider-svg-arrow" d="M.983,6.929,4.447,3.464.983,0,0,.983,2.482,3.464,0,5.946Z"></path>
          <path class="fashion-slider-svg-line" d="M80,0H0"></path>
        </g>
      </svg>
    </div>
  </div>
</div>

<script>
  let resizeTimeout;

  window.addEventListener('resize', () => {
    if (resizeTimeout) clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(updateSliderImage, 100); // Debounce resize event (adjust 100ms if needed)
  });

  window.addEventListener('load', updateSliderImage);

  function updateSliderImage() {
    const isMobile = window.innerWidth <= 768; // Adjust this value based on your mobile breakpoint
    const slides = document.querySelectorAll('.swiper-slide');

    slides.forEach(slide => {
      const imageElement = slide.querySelector('img.desktop_image');
      if (imageElement) {
        const mobileImage = imageElement.getAttribute('data-mobile-image'); // Get mobile image URL from data attribute
        const currentSrc = imageElement.src;

        if (isMobile && !currentSrc.includes(mobileImage)) {
          imageElement.setAttribute('src', mobileImage); // Set the mobile image if not already set
        } else if (!isMobile && !currentSrc.includes('master')) {
          imageElement.setAttribute('src', currentSrc.replace('mobile', 'master')); // Reset to desktop version for larger screens
        }
      }
    });
  }

document.addEventListener('DOMContentLoaded', function() {
  var swiper = new Swiper('.swiper', {
    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
    },
    loop: true,
    speed: 800,
    parallax: true,
    slidesPerView: 1,
    spaceBetween: 0,
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
  });
});
</script>

{% schema %}
{
  "name": "Custom Slider",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "text",
          "id": "image_content",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Select Mobile Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Slider"
    }
  ]
}
{% endschema %}