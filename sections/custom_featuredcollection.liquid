<style>
/* Custom Slider Styling */
.custom-slider {
  position: relative;
  width: 100%;
  overflow: hidden;
  max-width: 90%;
  margin: 0 auto;
  padding: 30px 0;
}

.slider-track {
  display: flex;
  transition: transform 0.5s ease-in-out;
}

.slider-item {
  min-width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  transform: scale(0.9);
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.slider-item.active {
  opacity: 1;
  transform: scale(1);
}

.product-card {
  border: 1px solid #e1e1e1;
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  width: 275px;
  background-color: #fff;
}

.product-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
}

.product-image img {
  width: 100%;
  height: auto;
  transition: transform 0.3s ease;
}

.product-card:hover .product-image img {
  transform: scale(1.05);
}

.product-info {
  padding: 15px;
  text-align: center;
}

.product-title {
  font-size: 1.2rem;
  font-weight: bold;
  margin-bottom: 8px;
}

.product-price {
  font-size: 1rem;
  color: #333;
}

.product-price__old {
  text-decoration: line-through;
  color: #999;
  font-size: 0.9rem;
  margin-right: 8px;
}

.product-price__new {
  font-weight: bold;
  color: #333;
}

/* Custom Navigation Buttons */
.slider-button {
  color: black;
  font-size: 22px;
  z-index: 10;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background-color: white;
  padding: 10px;
  border-radius: 50%;
  transition: background-color 0.3s ease;
  width: 45px;
  height: 45px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.slider-button-next {
  right: 20px;
}

.slider-button-prev {
  left: 20px;
}

/* Hover effect for navigation buttons */
.slider-button:hover {
  background-color: #333;
  color: white;
}

/* Section title */
h2.section-title {
  text-align: center;
  margin-bottom: 25px;
}

/* Mobile responsiveness */
@media (max-width: 768px) {
  .slider-item {
    min-width: 100% !important;
  }

  .custom-slider {
    max-width: 75%;
  }

  .slider-button {
    font-size: 24px;
    padding: 8px;
  }

  .slider-button-next {
    right: 10px;
  }

  .slider-button-prev {
    left: 10px;
  }
}

@media (min-width: 769px) {
  .slider-item {
    min-width: calc(25% - 20px);
  }

  .custom-slider {
    padding: 30px 0;
  }
}
</style>

<div class="custom-slider">
  <h2 class="section-title">{{ section.settings.section_title }}</h2>

  <div class="slider-track">
    {% assign products = collections[section.settings.collection].products %}
    {% for product in products %}
      <div class="slider-item">
        <div class="product-card">
          <div class="product-image">
            <img src="{{ product.featured_image | img_url: 'large' }}" alt="{{ product.title }}">
          </div>
          <div class="product-info">
            <h3 class="product-title">{{ product.title }}</h3>
            <p class="product-price">
              {% if product.compare_at_price %}
                <span class="product-price__old">{{ product.compare_at_price | money }}</span>
              {% endif %}
              <span class="product-price__new">{{ product.price | money }}</span>
            </p>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <!-- Custom Navigation Controls -->
  <div class="slider-button slider-button-prev">&lt;</div>
  <div class="slider-button slider-button-next">&gt;</div>
</div>

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  let currentIndex = 0;
  const items = document.querySelectorAll('.slider-item');
  const totalItems = items.length;
  const nextButton = document.querySelector('.slider-button-next');
  const prevButton = document.querySelector('.slider-button-prev');

  function showSlide(index) {
    items.forEach((item, i) => {
      item.classList.remove('active');
      if (i === index) {
        item.classList.add('active');
      }
    });
  }

  nextButton.addEventListener('click', function() {
    currentIndex = (currentIndex + 1) % totalItems;
    showSlide(currentIndex);
  });

  prevButton.addEventListener('click', function() {
    currentIndex = (currentIndex - 1 + totalItems) % totalItems;
    showSlide(currentIndex);
  });

  // Initialize first slide
  showSlide(currentIndex);
});
{% endjavascript %}

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "collection",
      "label": "Select Collection",
      "id": "collection",
      "info": "Choose the collection to display"
    },
    {
      "type": "text",
      "label": "Section Title",
      "id": "section_title",
      "default": "Featured Collection",
      "info": "Set a title for this section"
    },
    {
      "type": "number",
      "label": "Number of Products",
      "id": "num_products",
      "default": 4,
      "info": "Set the number of products to display at once"
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Collection"
    }
  ]
}
{% endschema %}