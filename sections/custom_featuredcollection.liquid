{% style %}
/* Swiper Slider Styling */
.swiper-container {
  position: relative;
  width: 100%;
  padding: 30px 0;
  margin: 0 auto;
  max-width: 90%;
}

.swiper-wrapper {
  display: flex;
  flex-wrap: nowrap;
}

.swiper-container.featured-collection-slider.swiper-initialized.swiper-horizontal .medium-up--one-quarter {
  width: 100% !important;
  padding: 0 !important;
}

.swiper-slide {
  display: flex;
  justify-content: center;
  transition: transform 0.3s ease;
}

.product-card {
  border: 1px solid #e1e1e1;
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  width: 275px;
  background-color: #fff;
  box-sizing: border-box;
}

.product-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
}

.product-image img {
  width: 100%;
  height: auto;
  transition: transform 0.3s ease;
}

.product-card:hover .product-image img {
  transform: scale(1.05);
}

.product-info {
  padding: 15px;
  text-align: center;
}

.product-title {
  font-size: 1.2rem;
  font-weight: bold;
  margin-bottom: 8px;
}

.product-price {
  font-size: 1rem;
  color: #333;
}

.product-price__old {
  text-decoration: line-through;
  color: #999;
  font-size: 0.9rem;
  margin-right: 8px;
}

.product-price__new {
  font-weight: bold;
  color: #333;
}

/* Swiper Navigation Buttons */
.swiper-button-next,
.swiper-button-prev {
  color: black;
  font-size: 22px;
  z-index: 10;
  position: absolute;
  top: 47%;
  transform: translateY(-50%);
  background-color: white;
  padding: 10px;
  border-radius: 50%;
  transition: background-color 0.3s ease;
  width: 45px;
  height: 45px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.swiper-button-next:before,
.swiper-button-prev:before {
  font-family: 'Font Awesome 5 Free';
  font-weight: 900;
}

.swiper-button-next {
  right: 20px;
}

.swiper-button-prev {
  left: 20px;
}

/* Hover effect for navigation buttons */
.swiper-button-next:hover,
.swiper-button-prev:hover {
  background-color: #333;
  color: white;
}

/* Hide pagination */
.swiper-pagination {
  display: none;
}

h2.section-title {
    text-align: center;
    margin-bottom: 25px;
}

.container_featuredcollection {
    max-width: 100%;
    overflow: hidden;
    width: 95% !important;
    margin: 0 auto;
}

/* Mobile responsiveness */
@media (max-width: 768px) {
  .swiper-slide {
    width: 100% !important;
  }

  .swiper-container {
    padding: 15px 0;
    max-width: 75%;
  }

  .swiper-button-next,
  .swiper-button-prev {
    font-size: 24px;
    padding: 8px;
  }

  .swiper-button-next {
      right: 10px;
  }

  .swiper-button-prev {
      left: 10px;
  }

  .container_featuredcollection {
      width: 100%;
  }
}

@media (min-width: 769px) {
  .swiper-slide {
    width: calc(25% - 20px);
  }

  .swiper-container {
    padding: 30px 0;
  }
}
{% endstyle %}

{% comment %}
  Featured Collection Section with Swiper Slider
{% endcomment %}

<div class="container_featuredcollection">
  <div class="swiper-container featured-collection-slider">
    <!-- Heading from Schema Settings -->
    <h2 class="section-title">{{ section.settings.section_title }}</h2>
  
    <div class="swiper-wrapper">
        {% assign products = collections[section.settings.collection].products %}
        {% for product in products %}
          <div class="swiper-slide">
            {% render 'product-grid-item', product: product %}
          </div>
        {% endfor %}
    </div>
  
    <!-- Pagination controls for Swiper (hidden) -->
    <div class="swiper-pagination"></div>
    <div class="swiper-button-next"><i class="fas fa-chevron-right"></i></div>
    <div class="swiper-button-prev"><i class="fas fa-chevron-left"></i></div>
  </div>
</div>

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  var swiper = new Swiper('.featured-collection-slider', {
    slidesPerView: 1,
    spaceBetween: 20,
    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
    },
    loop: true,
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    breakpoints: {
      768: {
        slidesPerView: 4, // 4 products on desktop
      },
    },
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "collection",
      "label": "Select Collection",
      "id": "collection",
      "info": "Choose the collection to display"
    },
    {
      "type": "text",
      "label": "Section Title",
      "id": "section_title",
      "default": "Featured Collection",
      "info": "Set a title for this section"
    },
    {
      "type": "number",
      "label": "Number of Products",
      "id": "num_products",
      "default": 4,
      "info": "Set the number of products to display at once"
    },
    {
      "type": "checkbox",
      "label": "Enable Autoplay",
      "id": "autoplay",
      "default": true,
      "info": "Toggle autoplay functionality"
    },
    {
      "type": "number",
      "label": "Autoplay Delay (ms)",
      "id": "autoplay_delay",
      "default": 5000,
      "info": "Set the delay for autoplay in milliseconds"
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Collection"
    }
  ]
}
{% endschema %}