<style>
/* Custom Slider Styling */
.custom-slider {
  position: relative;
  width: 100%;
  overflow: hidden;
  max-width: 90%;
  margin: 0 auto;
  padding: 30px 0;
}

.slider-track {
  display: flex;
  transition: transform 0.5s ease-in-out;
  will-change: transform;
}

.slider-item {
  min-width: 100%;
  box-sizing: border-box;
  transition: transform 0.5s ease, opacity 0.5s ease;
}

.slider-item.active {
  opacity: 1;
  transform: scale(1);
}

/* Custom Navigation Buttons */
.slider-button {
  color: black;
  font-size: 22px;
  z-index: 10;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background-color: white;
  padding: 10px;
  border-radius: 50%;
  transition: background-color 0.3s ease;
  width: 45px;
  height: 45px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.slider-button-next {
  right: 20px;
}

.slider-button-prev {
  left: 20px;
}

/* Hover effect for navigation buttons */
.slider-button:hover {
  background-color: #333;
  color: white;
}

/* Section title */
h2.section-title {
  text-align: center;
  margin-bottom: 25px;
}

/* Mobile responsiveness */
@media (max-width: 768px) {
  .slider-item {
    min-width: 100% !important;
  }

  .custom-slider {
    max-width: 75%;
  }

  .slider-button {
    font-size: 24px;
    padding: 8px;
  }

  .slider-button-next {
    right: 10px;
  }

  .slider-button-prev {
    left: 10px;
  }
}

@media (min-width: 769px) {
  .slider-item {
    min-width: calc(25% - 20px);
  }

  .custom-slider {
    padding: 30px 0;
  }
}
</style>

<div class="custom-slider">
  <h2 class="section-title">{{ section.settings.section_title }}</h2>

  <div class="slider-track">
    {% assign products = collections[section.settings.collection].products %}
    {% for product in products %}
      <div class="slider-item">
        {% render 'product-grid-item', product: product %}
      </div>
    {% endfor %}
  </div>

  <!-- Custom Navigation Controls -->
  <div class="slider-button slider-button-prev">&lt;</div>
  <div class="slider-button slider-button-next">&gt;</div>
</div>

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const sliderTrack = document.querySelector('.slider-track');
  const items = document.querySelectorAll('.slider-item');
  const nextButton = document.querySelector('.slider-button-next');
  const prevButton = document.querySelector('.slider-button-prev');
  let currentIndex = 0;
  let totalItems = items.length;
  let slideWidth = items[0].clientWidth;

  // Function to move to the next slide
  function moveToNext() {
    if (currentIndex < totalItems - 1) {
      currentIndex++;
    } else {
      currentIndex = 0;
    }
    sliderTrack.style.transform = `translateX(-${slideWidth * currentIndex}px)`;
  }

  // Function to move to the previous slide
  function moveToPrev() {
    if (currentIndex > 0) {
      currentIndex--;
    } else {
      currentIndex = totalItems - 1;
    }
    sliderTrack.style.transform = `translateX(-${slideWidth * currentIndex}px)`;
  }

  // Event listeners for buttons
  nextButton.addEventListener('click', moveToNext);
  prevButton.addEventListener('click', moveToPrev);

  // Autoplay functionality (optional)
  if ({{ section.settings.autoplay | default: true }}) {
    setInterval(moveToNext, {{ section.settings.autoplay_delay | default: 5000 }});
  }

  // Recalculate slide width on window resize
  window.addEventListener('resize', function() {
    slideWidth = items[0].clientWidth;
    sliderTrack.style.transform = `translateX(-${slideWidth * currentIndex}px)`;
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "collection",
      "label": "Select Collection",
      "id": "collection",
      "info": "Choose the collection to display"
    },
    {
      "type": "text",
      "label": "Section Title",
      "id": "section_title",
      "default": "Featured Collection",
      "info": "Set a title for this section"
    },
    {
      "type": "number",
      "label": "Autoplay Delay (ms)",
      "id": "autoplay_delay",
      "default": 5000,
      "info": "Set the delay for autoplay in milliseconds"
    },
    {
      "type": "checkbox",
      "label": "Enable Autoplay",
      "id": "autoplay",
      "default": true,
      "info": "Toggle autoplay functionality"
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Collection"
    }
  ]
}
{% endschema %}